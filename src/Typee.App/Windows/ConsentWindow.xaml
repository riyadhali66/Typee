<Window x:Class="Typee.App.Windows.ConsentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Typee — Privacy"
        Height="480"
        Width="560"
        MinHeight="400"
        MinWidth="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Icon="pack://application:,,,/Assets/typee.ico"
        Background="#FFF7F8FA">
  <DockPanel Margin="24">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Not now — local only" Width="160" Margin="0,0,8,0" IsCancel="True" Click="OnLocalOnly"/>
      <Button Content="I understand" Width="120" IsDefault="True" Click="OnAccept"/>
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="Welcome to Typee" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="Typee helps you write with local grammar checks, phrases, and optional AI completions. Please review what stays on this PC versus what can be sent to an LLM endpoint you configure."/>
        <TextBlock Text="Stays on this PC (local)" FontWeight="SemiBold" Margin="0,8,0,4"/>
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="• Keyboard hook timing (never raw keystrokes or typed text in logs)&#10;• Harper grammar checks (offline)&#10;• Phrase trie, completion cache, dictionary, snippets (SQLite)&#10;• Settings (no API keys) and diagnostic counts"/>
        <TextBlock Text="Sent only if you enable LLM features" FontWeight="SemiBold" Margin="0,8,0,4"/>
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="• Short text snippets around the caret (paragraph / completion context) to the OpenAI-compatible endpoint in Settings → LLM&#10;• API keys are stored in Windows Credential Manager or an environment variable — never in settings.json, the database, or logs"/>
        <TextBlock TextWrapping="Wrap" Foreground="#FF555555"
                   Text="You can use Typee with local features only. LLM features stay off until you accept and configure an endpoint."/>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
