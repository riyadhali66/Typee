<Window x:Class="Typee.App.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Typee Settings"
        Height="720"
        Width="760"
        MinHeight="560"
        MinWidth="640"
        WindowStartupLocation="CenterScreen"
        Background="#FFF7F8FA">
  <!--
    Callers: TrayIconHost.ShowSettings creates SettingsWindow.
    Phase 1 spec: tabbed window starting with General + Hotkeys + LLM, with hotkey capture.
  -->
  <Window.Resources>
    <Style TargetType="TextBox">
      <Setter Property="Margin" Value="0,0,0,8"/>
      <Setter Property="Padding" Value="6,4"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Margin" Value="0,0,0,8"/>
      <Setter Property="Padding" Value="6,4"/>
    </Style>
    <Style x:Key="SectionHeader" TargetType="TextBlock">
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,12,0,8"/>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,0,0,4"/>
      <Setter Property="Foreground" Value="#FF333333"/>
    </Style>
    <Style x:Key="TabScroll" TargetType="ScrollViewer">
      <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
      <Setter Property="Padding" Value="0,0,12,0"/>
    </Style>
  </Window.Resources>

  <DockPanel Margin="16">
    <DockPanel DockPanel.Dock="Bottom" LastChildFill="False" Margin="0,12,0,0">
      <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="#FF555555" TextTrimming="CharacterEllipsis"/>
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
        <Button Content="Reload" Width="90" Margin="0,0,8,0" Command="{Binding ReloadCommand}"/>
        <Button Content="Save" Width="90" IsDefault="True" Command="{Binding SaveCommand}"/>
      </StackPanel>
    </DockPanel>

    <TabControl>
      <TabItem Header="General">
        <ScrollViewer Style="{StaticResource TabScroll}">
          <StackPanel>
            <TextBlock Text="Application" Style="{StaticResource SectionHeader}"/>
            <CheckBox Content="Pause overlays in fullscreen" IsChecked="{Binding PauseInFullscreen}"
                      AutomationProperties.Name="Pause overlays in fullscreen"/>
            <TextBlock Text="UI language" Style="{StaticResource FieldLabel}"/>
            <ComboBox ItemsSource="{Binding UiLanguages}" SelectedItem="{Binding UiLanguage}"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
              <Button Content="Export…" Width="90" Margin="0,0,8,0" Command="{Binding ExportSettingsCommand}"/>
              <Button Content="Import…" Width="90" Margin="0,0,8,0" Command="{Binding ImportSettingsCommand}"/>
              <Button Content="Reset defaults" Command="{Binding ResetSettingsCommand}"/>
            </StackPanel>
            <TextBlock Text="{Binding LoadNoticesText}" TextWrapping="Wrap" Foreground="#FF666666" Margin="0,0,0,8"/>

            <TextBlock Text="Suggestions" Style="{StaticResource SectionHeader}"/>
            <CheckBox Content="Suggestions enabled" IsChecked="{Binding SuggestionsEnabled}"/>
            <TextBlock Text="Debounce (ms)" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding DebounceMs, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="Minimum characters before suggest" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding MinCharsBeforeSuggest, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="Max context characters" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding MaxContextChars, UpdateSourceTrigger=PropertyChanged}"/>
            <CheckBox Content="Level 1 grammar enabled" IsChecked="{Binding Level1GrammarEnabled}"/>
            <CheckBox Content="Level 2 completion enabled" IsChecked="{Binding Level2CompletionEnabled}"/>
            <TextBlock Text="Completion cache TTL (hours)" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding CompletionCacheTtlHours, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Text="Grammar (Harper)" Style="{StaticResource SectionHeader}"/>
            <TextBlock Text="Dialect" Style="{StaticResource FieldLabel}"/>
            <ComboBox ItemsSource="{Binding Dialects}" SelectedItem="{Binding GrammarDialect}"/>
            <CheckBox Content="LLM deep check when Harper finds nothing" IsChecked="{Binding LlmDeepCheck}"/>
            <TextBlock Text="Disabled rules (comma-separated)" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding DisabledRulesText, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="Request timeout (ms)" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding GrammarTimeoutMs, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Text="Translate targets (comma-separated, used from Phase 8A)" Style="{StaticResource SectionHeader}"/>
            <TextBox Text="{Binding TranslateTargetsText, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Text="Voice typing (used from Phase 9)" Style="{StaticResource SectionHeader}"/>
            <TextBlock Text="Model" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding SpeechModel, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="Language" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding SpeechLanguage, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="Insert mode" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding SpeechInsertMode, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Text="Privacy" Style="{StaticResource SectionHeader}"/>
            <TextBlock Text="Blocked processes (one per line) — Typee stays inert in these" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding BlockedProcessesText, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     Height="100"
                     VerticalScrollBarVisibility="Auto"
                     TextWrapping="Wrap"/>
            <CheckBox Content="Start with Windows (wired in Phase 10)" IsChecked="{Binding StartWithWindows}"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Hotkeys">
        <ScrollViewer Style="{StaticResource TabScroll}">
          <StackPanel>
            <TextBlock Text="Hotkeys" Style="{StaticResource SectionHeader}"/>
            <TextBlock Text="Click Capture, then press the desired combination. Esc cancels capture. Alt+Space is never allowed." Foreground="#FF666666" Margin="0,0,0,8"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0" Text="Command bar" Style="{StaticResource FieldLabel}"/>
              <TextBox Grid.Row="1" Text="{Binding CommandBarHotkey, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"/>
              <Button Grid.Row="1" Grid.Column="1" Content="Capture" Margin="8,0,0,8" Width="80" Click="CaptureCommandBar_OnClick"/>

              <TextBlock Grid.Row="2" Text="Send to last AI target" Style="{StaticResource FieldLabel}"/>
              <TextBox Grid.Row="3" Text="{Binding SendToLastAiHotkey, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"/>
              <Button Grid.Row="3" Grid.Column="1" Content="Capture" Margin="8,0,0,8" Width="80" Click="CaptureSendToLastAi_OnClick"/>

              <TextBlock Grid.Row="4" Text="List style picker" Style="{StaticResource FieldLabel}"/>
              <TextBox Grid.Row="5" Text="{Binding ListStylePickerHotkey, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"/>
              <Button Grid.Row="5" Grid.Column="1" Content="Capture" Margin="8,0,0,8" Width="80" Click="CaptureListStylePicker_OnClick"/>

              <TextBlock Grid.Row="6" Text="Toggle checklist item" Style="{StaticResource FieldLabel}"/>
              <TextBox Grid.Row="7" Text="{Binding ToggleChecklistHotkey, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"/>
              <Button Grid.Row="7" Grid.Column="1" Content="Capture" Margin="8,0,0,8" Width="80" Click="CaptureToggleChecklist_OnClick"/>

              <TextBlock Grid.Row="8" Text="Push to talk (hold)" Style="{StaticResource FieldLabel}"/>
              <TextBox Grid.Row="9" Text="{Binding PushToTalkHotkey, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"/>
              <Button Grid.Row="9" Grid.Column="1" Content="Capture" Margin="8,0,0,8" Width="80" Click="CapturePushToTalk_OnClick"/>

              <TextBlock Grid.Row="10" Text="Accept suggestion" Style="{StaticResource FieldLabel}"/>
              <TextBox Grid.Row="11" Text="{Binding AcceptSuggestionHotkey, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"/>
              <Button Grid.Row="11" Grid.Column="1" Content="Capture" Margin="8,0,0,8" Width="80" Click="CaptureAcceptSuggestion_OnClick"/>

              <TextBlock Grid.Row="12" Text="Dismiss" Style="{StaticResource FieldLabel}"/>
              <TextBox Grid.Row="13" Text="{Binding DismissHotkey, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"/>
              <Button Grid.Row="13" Grid.Column="1" Content="Capture" Margin="8,0,0,8" Width="80" Click="CaptureDismiss_OnClick"/>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="My phrases">
        <ScrollViewer Style="{StaticResource TabScroll}">
          <StackPanel>
            <TextBlock Text="My phrases" Style="{StaticResource SectionHeader}"/>
            <TextBlock TextWrapping="Wrap" Foreground="#FF666666" Margin="0,0,0,8"
                       Text="Saved phrases power fast local completions (prefix match on the last 1–5 words). Accepted suggestions are learned after 3 accepts."/>
            <DockPanel Margin="0,0,0,8">
              <Button DockPanel.Dock="Right" Content="Add" Width="80" Margin="8,0,0,0" Command="{Binding AddPhraseCommand}"/>
              <TextBox Text="{Binding NewPhraseText, UpdateSourceTrigger=PropertyChanged}"/>
            </DockPanel>
            <ListBox ItemsSource="{Binding Phrases}" SelectedItem="{Binding SelectedPhrase}" Height="280"
                     DisplayMemberPath="Text" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal">
              <Button Content="Delete" Width="90" Margin="0,0,8,0" Command="{Binding DeletePhraseCommand}"/>
              <Button Content="Import…" Width="90" Margin="0,0,8,0" Command="{Binding ImportPhrasesCommand}"/>
              <Button Content="Export…" Width="90" Command="{Binding ExportPhrasesCommand}"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="My dictionary">
        <ScrollViewer Style="{StaticResource TabScroll}">
          <StackPanel>
            <TextBlock Text="My dictionary" Style="{StaticResource SectionHeader}"/>
            <TextBlock TextWrapping="Wrap" Foreground="#FF666666" Margin="0,0,0,8"
                       Text="Words added here are ignored by Harper grammar (wired in Phase 6)."/>
            <DockPanel Margin="0,0,0,8">
              <Button DockPanel.Dock="Right" Content="Add" Width="80" Margin="8,0,0,0" Command="{Binding AddDictionaryWordCommand}"/>
              <TextBox Text="{Binding NewDictionaryWord, UpdateSourceTrigger=PropertyChanged}"/>
            </DockPanel>
            <ListBox ItemsSource="{Binding DictionaryWords}" SelectedItem="{Binding SelectedDictionaryWord}" Height="280"
                     DisplayMemberPath="Word" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal">
              <Button Content="Delete" Width="90" Margin="0,0,8,0" Command="{Binding DeleteDictionaryWordCommand}"/>
              <Button Content="Import…" Width="90" Margin="0,0,8,0" Command="{Binding ImportDictionaryCommand}"/>
              <Button Content="Export…" Width="90" Command="{Binding ExportDictionaryCommand}"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Privacy &amp; data">
        <ScrollViewer Style="{StaticResource TabScroll}">
          <StackPanel>
            <TextBlock Text="What Typee stores locally" Style="{StaticResource SectionHeader}"/>
            <TextBlock TextWrapping="Wrap" Foreground="#FF555555" Margin="0,0,0,12"
                       Text="{Binding StorageSummary}"/>
            <Button Content="Clear learned data…" HorizontalAlignment="Left" Margin="0,0,0,8" Command="{Binding ClearLearnedDataCommand}"/>
            <Button Content="Delete all Typee data…" HorizontalAlignment="Left" Command="{Binding DeleteAllDataCommand}"/>
            <TextBlock TextWrapping="Wrap" Foreground="#FF888888" Margin="0,12,0,0"
                       Text="Clear learned data keeps snippets, custom commands, settings, and logs. Delete all removes the whole %LOCALAPPDATA%\Typee folder contents Typee manages (settings, database, logs, crash marker) and recreates an empty database."/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="LLM">
        <ScrollViewer Style="{StaticResource TabScroll}">
          <StackPanel>
            <TextBlock Text="LLM (OpenAI-compatible /v1/chat/completions)" Style="{StaticResource SectionHeader}"/>
            <TextBlock Text="Any OpenAI-compatible endpoint works: Ollama, vLLM, DeepSeek, OpenAI, Z.ai GLM (used from Phase 7)." Foreground="#FF666666" Margin="0,0,0,8"/>
            <TextBlock Text="Base URL" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding LlmBaseUrl, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="Model" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding LlmModel, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="API key environment variable (never stored in settings.json)" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding ApiKeyEnvVar, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="Timeout (ms)" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding LlmTimeoutMs, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="Max tokens" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding LlmMaxTokens, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="Temperature" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding LlmTemperature, UpdateSourceTrigger=PropertyChanged}"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
